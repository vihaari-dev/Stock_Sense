# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stocksense_dev
DB_USER=root
DB_PASS=your_mysql_password

# JWT
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_NEVER_COMMIT_THIS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Cookies
COOKIE_SECURE=false

# OTP
OTP_EXPIRES_MINUTES=15

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="StockSense <no-reply@stocksense.local>"

# CORS
CLIENT_ORIGIN=http://localhost:5173
